{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "ogm": {
      "type": "local",
      "command": [
        "uvx",
        "ogm-mcp-skills==0.2.2"
      ],
      "environment": {
        "OGM_BASE_URL": "{env:OGM_BASE_URL}",
        "OGM_API_KEY": "{env:OGM_API_KEY}",
        "OGM_PROJECT_ID": "{env:OGM_PROJECT_ID}",
        "OGM_PERMISSION_PROFILE": "{env:OGM_PERMISSION_PROFILE}"
      },
      "enabled": true
    }
  }
}
